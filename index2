<body>

  <!-- Carte en fond -->
  <div id="map"></div>

  <!-- Écran d'accueil -->
  <div id="homeScreen" class="overlay">
    <h1>Glide Planner</h1>

    <button class="menuBtn" onclick="goTo('prepScreen')">Préparation</button>
    <button class="menuBtn" onclick="goTo('volScreen')">Mode Vol</button>
    <button class="menuBtn" onclick="goTo('manuelScreen')">Manuel</button>
  </div>

  <!-- Écran Préparation (ton outil actuel viendra ici) -->
  <div id="prepScreen" class="screen" style="display:none;">
    <button class="backBtn" onclick="goTo('homeScreen')">← Retour</button>

    <!-- ICI on collera ton code de préparation complet -->
    <div id="prepContent"></div>
  </div>

  <!-- Écran Mode Vol -->
  <div id="volScreen" class="screen" style="display:none;">
    <button class="backBtn" onclick="goTo('homeScreen')">← Retour</button>
    <h2>Mode Vol</h2>
    <p>À définir ensemble.</p>
  </div>

  <!-- Écran Manuel -->
  <div id="manuelScreen" class="screen" style="display:none;">
    <button class="backBtn" onclick="goTo('homeScreen')">← Retour</button>
    <h2>Manuel</h2>
    <p>Documentation à venir.</p>
  </div>

  <style>
    /* Carte */
    #map {
      position:fixed;
      top:0; left:0;
      width:100%; height:100%;
      z-index:1;
    }

    /* Voile sombre */
    .overlay {
      position:fixed;
      top:0; left:0;
      width:100%; height:100%;
      background:rgba(0,0,0,0.55);
      z-index:2;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      text-align:center;
      color:white;
      backdrop-filter: blur(3px);
    }

    .overlay h1 {
      font-size:40px;
      margin-bottom:30px;
      text-shadow:0 0 10px black;
    }

    .menuBtn {
      width:220px;
      padding:15px;
      margin:10px;
      font-size:20px;
      border:none;
      border-radius:10px;
      background:#ffffffcc;
      color:#000;
      cursor:pointer;
      font-weight:bold;
      box-shadow:0 2px 6px rgba(0,0,0,0.3);
    }

    .menuBtn:hover {
      background:white;
    }

    /* Écrans internes */
    .screen {
      position:fixed;
      top:0; left:0;
      width:100%; height:100%;
      background:rgba(255,255,255,0.95);
      z-index:3;
      overflow:auto;
      padding:10px;
    }

    .backBtn {
      position:absolute;
      top:10px; left:10px;
      padding:10px 15px;
      font-size:18px;
      border:none;
      border-radius:8px;
      background:#333;
      color:white;
      cursor:pointer;
      z-index:4;
    }
  </style>

  <script>
    function goTo(screenId){
      // cacher tous les écrans
      document.getElementById("homeScreen").style.display = "none";
      document.getElementById("prepScreen").style.display = "none";
      document.getElementById("volScreen").style.display = "none";
      document.getElementById("manuelScreen").style.display = "none";

      // afficher celui demandé
      document.getElementById(screenId).style.display = "block";
    }
  </script>

</body>
